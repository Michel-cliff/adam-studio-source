{
  "name": "adam-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "adam": "tsx packages/render/src/cli.ts",
    "ui": "tsx packages/web/server/main.ts",
    "skill": "tsx packages/web/server/skill.ts",
    "setup": "tsx packages/web/server/setup.ts",
    "postinstall": "tsx packages/web/server/setup.ts",
    "desktop": "npm run start -w @adam-studio/desktop",
    "desktop:smoke": "npm run smoke -w @adam-studio/desktop",
    "desktop:make": "npm run make -w @adam-studio/desktop"
  }
}
