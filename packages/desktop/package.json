{
  "name": "@adam-studio/desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Adam Studio desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "node launch.mjs",
    "test": "node --test policy.test.cjs runtime.test.cjs updates.test.cjs crash.test.cjs",
    "smoke": "node launch.mjs --smoke-test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:runtime": "node prepare-runtime.mjs",
    "package": "npm run prepare:runtime && electron-forge package --platform=win32 --arch=x64",
    "make": "npm run prepare:runtime && electron-forge package --platform=win32 --arch=x64 && node make-installer.mjs",
    "make:installer": "node make-installer.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "electron": "45.2.2",
    "electron-winstaller": "5.4.4"
  },
  "type": "module",
  "author": "Michel-Cliff",
  "productName": "Adam Studio",
  "config": {
    "forge": "./forge.config.cjs"
  }
}
