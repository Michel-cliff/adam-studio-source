{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "textLayout": {
      "type": "string",
      "enum": [
        "thirds",
        "free"
      ]
    },
    "fonts": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "capcutResourceId": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "file"
          ],
          "additionalProperties": false
        },
        "title": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "capcutResourceId": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "file"
          ],
          "additionalProperties": false
        },
        "accent": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "capcutResourceId": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "file"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "caption",
        "title"
      ],
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "text",
        "highlight",
        "accent",
        "ink"
      ],
      "additionalProperties": false
    },
    "grade": {
      "default": {
        "warmth": 0,
        "contrast": 0,
        "saturation": 0,
        "brightness": 0,
        "vignette": 0
      },
      "type": "object",
      "properties": {
        "warmth": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "contrast": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "saturation": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "brightness": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "vignette": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "inserts": {
      "default": {
        "bw": 0,
        "grain": 0,
        "bloom": 0
      },
      "type": "object",
      "properties": {
        "bw": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grain": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bloom": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "fx": {
      "default": {
        "grain": 0,
        "scanlines": {
          "window": 0,
          "burst": 0,
          "burstFrames": 3
        },
        "zoomBlur": 0
      },
      "type": "object",
      "properties": {
        "grain": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scanlines": {
          "default": {
            "window": 0,
            "burst": 0,
            "burstFrames": 3
          },
          "type": "object",
          "properties": {
            "window": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "burst": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "burstFrames": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        "zoomBlur": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 40
        }
      },
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stroke": {
          "default": 0.08,
          "type": "number",
          "minimum": 0
        },
        "shadow": {
          "default": true,
          "type": "boolean"
        },
        "maxCharsPerLine": {
          "default": 22,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "intro": {
          "default": "miniZoom",
          "type": "string"
        },
        "highlightAs": {
          "default": "color",
          "type": "string",
          "enum": [
            "color",
            "block",
            "serif"
          ]
        }
      },
      "required": [
        "size"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "track": {
          "default": "#000000",
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "trackOpacity": {
          "default": 0.4,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "height": {
          "default": 6,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 40
        },
        "bottom": {
          "default": 24,
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "block": {
          "default": 24,
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "gap": {
          "default": 2,
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "color"
      ],
      "additionalProperties": false
    },
    "motion": {
      "default": {
        "speed": 1,
        "stable": true
      },
      "type": "object",
      "properties": {
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "stable": {
          "default": true,
          "type": "boolean"
        },
        "push": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.03
        }
      },
      "additionalProperties": false
    },
    "fillers": {
      "default": {
        "fr": [
          "euh",
          "heu",
          "bah",
          "ben",
          "du coup",
          "en fait"
        ],
        "en": [
          "um",
          "uh",
          "erm",
          "like",
          "you know",
          "i mean",
          "basically"
        ],
        "es": [
          "eh",
          "este",
          "o sea",
          "pues",
          "bueno"
        ],
        "de": [
          "äh",
          "ähm",
          "also",
          "halt",
          "sozusagen"
        ],
        "it": [
          "ehm",
          "cioè",
          "tipo",
          "allora",
          "praticamente"
        ],
        "pt": [
          "é",
          "tipo",
          "né",
          "então",
          "assim"
        ]
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "9:16",
          "16:9"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "9:16",
        "16:9"
      ]
    },
    "lint": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "9:16",
          "16:9"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minDurationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxDurationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxPauseMs": {
            "default": 350,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "fillers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "da": {
            "type": "object",
            "properties": {
              "maxShotMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maxScaleGapMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "windows": {
                "type": "object",
                "properties": {
                  "min": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              "rareColors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "color",
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "maxCaptionWords": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "cutsOnly": {
                "type": "boolean"
              },
              "musicFromMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "noShake": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "minDurationMs",
          "maxDurationMs"
        ],
        "additionalProperties": false
      },
      "required": [
        "9:16",
        "16:9"
      ]
    }
  },
  "required": [
    "name",
    "fonts",
    "colors",
    "caption",
    "slots",
    "lint"
  ],
  "additionalProperties": false
}
