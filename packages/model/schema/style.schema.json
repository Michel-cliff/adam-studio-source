{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fonts": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "capcutResourceId": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "file"
          ],
          "additionalProperties": false
        },
        "title": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "capcutResourceId": {
              "type": "string"
            }
          },
          "required": [
            "family",
            "file"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "caption",
        "title"
      ],
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "text",
        "highlight",
        "accent",
        "ink"
      ],
      "additionalProperties": false
    },
    "grade": {
      "default": {
        "warmth": 0,
        "contrast": 0,
        "saturation": 0,
        "brightness": 0,
        "vignette": 0
      },
      "type": "object",
      "properties": {
        "warmth": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "contrast": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "saturation": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "brightness": {
          "default": 0,
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "vignette": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "inserts": {
      "default": {
        "bw": 0,
        "grain": 0,
        "bloom": 0
      },
      "type": "object",
      "properties": {
        "bw": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grain": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bloom": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "fx": {
      "default": {
        "grain": 0,
        "scanlines": {
          "window": 0,
          "burst": 0,
          "burstFrames": 3
        },
        "zoomBlur": 0
      },
      "type": "object",
      "properties": {
        "grain": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scanlines": {
          "default": {
            "window": 0,
            "burst": 0,
            "burstFrames": 3
          },
          "type": "object",
          "properties": {
            "window": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "burst": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "burstFrames": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        "zoomBlur": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 40
        }
      },
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stroke": {
          "default": 0.08,
          "type": "number",
          "minimum": 0
        },
        "shadow": {
          "default": true,
          "type": "boolean"
        },
        "maxCharsPerLine": {
          "default": 22,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "intro": {
          "default": "miniZoom",
          "type": "string"
        }
      },
      "required": [
        "size"
      ],
      "additionalProperties": false
    },
    "motion": {
      "default": {
        "speed": 1
      },
      "type": "object",
      "properties": {
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "push": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.03
        }
      },
      "additionalProperties": false
    },
    "fillers": {
      "default": {
        "fr": [
          "euh",
          "heu",
          "bah",
          "ben",
          "du coup",
          "en fait"
        ],
        "en": [
          "um",
          "uh",
          "erm",
          "like",
          "you know",
          "i mean",
          "basically"
        ],
        "es": [
          "eh",
          "este",
          "o sea",
          "pues",
          "bueno"
        ],
        "de": [
          "äh",
          "ähm",
          "also",
          "halt",
          "sozusagen"
        ],
        "it": [
          "ehm",
          "cioè",
          "tipo",
          "allora",
          "praticamente"
        ],
        "pt": [
          "é",
          "tipo",
          "né",
          "então",
          "assim"
        ]
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "9:16",
          "16:9"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "9:16",
        "16:9"
      ]
    },
    "lint": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "9:16",
          "16:9"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minDurationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxDurationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maxPauseMs": {
            "default": 350,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "fillers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "minDurationMs",
          "maxDurationMs"
        ],
        "additionalProperties": false
      },
      "required": [
        "9:16",
        "16:9"
      ]
    }
  },
  "required": [
    "name",
    "fonts",
    "colors",
    "caption",
    "slots",
    "lint"
  ],
  "additionalProperties": false
}
