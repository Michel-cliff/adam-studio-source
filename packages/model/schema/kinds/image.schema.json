{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "fit": {
      "default": "full",
      "type": "string",
      "enum": [
        "full",
        "contain",
        "cover"
      ]
    },
    "intro": {
      "type": "string"
    },
    "outro": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 1
    },
    "startMs": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "volume": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "paper": {
      "default": false,
      "type": "boolean"
    },
    "frame": {
      "type": "string",
      "enum": [
        "sticker",
        "fig",
        "notch",
        "loading",
        "folder",
        "auto"
      ]
    }
  },
  "required": [
    "asset"
  ],
  "additionalProperties": false
}
