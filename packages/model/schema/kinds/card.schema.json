{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archetype": {
      "type": "string",
      "enum": [
        "statement",
        "number",
        "opposition",
        "list",
        "quote",
        "breath"
      ]
    },
    "text": {
      "default": "",
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "against": {
      "type": "string"
    },
    "items": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "archetype"
  ],
  "additionalProperties": false
}
