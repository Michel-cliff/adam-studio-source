{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "current": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sky": {
      "default": [
        "#2F6FCF",
        "#A9D3FF"
      ],
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "iconColor": {
      "default": "highlight",
      "type": "string"
    },
    "selection": {
      "default": "#0A64D8",
      "type": "string"
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
