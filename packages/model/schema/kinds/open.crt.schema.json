{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "line": {
      "default": "text",
      "type": "string"
    },
    "lineHeight": {
      "default": 4,
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 20
    },
    "openMs": {
      "default": 400,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scanlines": {
      "default": 0.3,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scanlineFrames": {
      "default": 3,
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    }
  },
  "additionalProperties": false
}
