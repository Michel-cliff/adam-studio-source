{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "default": "",
      "type": "string"
    },
    "lines": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset": {
      "type": "string"
    },
    "color": {
      "default": "accent",
      "type": "string"
    },
    "typing": {
      "default": true,
      "type": "boolean"
    },
    "width": {
      "default": 0.8,
      "type": "number",
      "minimum": 0.2,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
