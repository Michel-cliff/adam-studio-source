{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "backdrop": {
      "default": "blur",
      "type": "string",
      "enum": [
        "color",
        "blur"
      ]
    },
    "color": {
      "default": "#F4F2ED",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "barColor": {
      "default": "#525252",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "width": {
      "default": 0.8,
      "type": "number",
      "minimum": 0.3,
      "maximum": 1
    },
    "y": {
      "default": 0.42,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "focusY": {
      "default": 0.4,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "easeMs": {
      "default": 300,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chrome": {
      "default": "plain",
      "type": "string",
      "enum": [
        "plain",
        "window",
        "poster",
        "terminal",
        "win95",
        "board"
      ]
    },
    "frame": {
      "type": "string",
      "enum": [
        "sticker",
        "fig",
        "notch",
        "loading",
        "folder"
      ]
    },
    "header": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
