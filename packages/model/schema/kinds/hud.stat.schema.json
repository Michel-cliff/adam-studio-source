{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "from": {
      "default": 0,
      "type": "number"
    },
    "prefix": {
      "default": "",
      "type": "string"
    },
    "suffix": {
      "default": "",
      "type": "string"
    },
    "decimals": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "color": {
      "default": "accent",
      "type": "string"
    },
    "countMs": {
      "default": 900,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "label",
    "value"
  ],
  "additionalProperties": false
}
